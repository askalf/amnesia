# Cloudflare Pages headers for amnesia.tax (front-end).
# Versioned here so security headers deploy with the site (no CF Transform Rule
# / token needed). CSP is matched to exactly what the SPA loads:
#   - Turnstile script + iframe : https://challenges.cloudflare.com
#   - fonts                     : self-hosted under /fonts/ (no Google Fonts origins)
#   - the search API fetch       : https://api.amnesia.tax
#   - inline <style> + <script>  : 'unsafe-inline' (single-file app; no per-request nonce on static Pages)
#   - favicon (data: svg) + og   : data: / 'self'
#   - result thumbnails          : https: (image_proxy state varies by deploy; keep
#                                   blanket https: until image_proxy is confirmed on
#                                   live, then tighten to api.amnesia.tax — verify in
#                                   a browser, image search breaks if mismatched)
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://api.amnesia.tax https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# The SPA only changes on deploy, and Pages purges its cache then — let the
# edge serve it without an origin revalidation per request (was max-age=0).
/
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# Immutable font files (bump the filename to change them).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
