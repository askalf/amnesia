# Cloudflare Pages headers for amnesia.sprayberrylabs.com (front-end).
# Versioned here so security headers deploy with the site (no CF Transform Rule
# / token needed). CSP is matched to exactly what the SPA loads:
#   - Turnstile script + iframe : https://challenges.cloudflare.com
#   - fonts                     : self-hosted under /fonts/ (no Google Fonts origins)
#   - the search API fetch       : https://amnesia-api.sprayberrylabs.com
#   - inline <style> + <script>  : by SHA-256 hash, no 'unsafe-inline' (scripts/csp-hashes.mjs --write)
#   - favicon (data: svg) + og   : data: / 'self'
#   - result thumbnails          : https://amnesia-api.sprayberrylabs.com (the gate rewrites each
#                                   image URL to its signed /img proxy, so the browser loads
#                                   thumbnails from the gate and never connects to an image host)
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-fr85jf+TS7lcnQRxnjWCdCjNyJDCcljDRdE6IatAwDk=' https://challenges.cloudflare.com; style-src 'self' 'sha256-kf65YGE17RKwx+m5uoIbUiZlrtKF1ViXiqCopVFmKx0='; font-src 'self'; img-src 'self' data: https://amnesia-api.sprayberrylabs.com; connect-src 'self' https://amnesia-api.sprayberrylabs.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# The SPA only changes on deploy, and Pages purges its cache then — let the
# edge serve it without an origin revalidation per request (was max-age=0).
/
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# Immutable font files (bump the filename to change them).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
