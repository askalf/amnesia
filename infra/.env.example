# amnesia backend — environment for infra/docker-compose.yml
# Copy to .env on the host (/root/amnesia/.env) and fill in. NEVER commit .env.

# Secret key for SearXNG (generate: `openssl rand -hex 32`)
AMNESIA_SEARXNG_SECRET=

# Password for the amnesia-valkey limiter store (generate: `openssl rand -hex 24`)
AMNESIA_VALKEY_PASSWORD=

# Real name of the platform stack's external docker network.
# Find it on the host with:  docker network ls | grep askalf-net
# (compose default is usually <project>_askalf-net, e.g. askalf_askalf-net)
ASKALF_NET_NAME=askalf_askalf-net
